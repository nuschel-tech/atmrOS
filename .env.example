# ─────────────────────────────────────────────────────────────
# atmrOS — environment configuration
# Copy this file to `.env` and fill in the values you need.
# Only variables prefixed with PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Plausible Analytics
# Domain and API host are baked into the app:
#   domain   -> atomar.org
#   apiHost  -> https://analytics.multaenhavo.com (self-hosted, MultaEnhavo)
# Localhost is never tracked, so development stays silent automatically.
# Set these ONLY to override the built-in defaults.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_API_HOST=

# Backend API that feeds the map/dashboard (data is collected elsewhere
# and served through this endpoint). Consumed by the display frontend.
PUBLIC_API_BASE_URL=
