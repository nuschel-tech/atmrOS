# ─────────────────────────────────────────────────────────────
# atmrOS — environment configuration
# Copy this file to `.env` and fill in the values you need.
# Only variables prefixed with PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Plausible Analytics
# Leave PUBLIC_PLAUSIBLE_DOMAIN empty to keep analytics OFF.
# Set it to your site domain to switch tracking ON (no rebuild needed
# with adapter-auto/SSR — it is read at runtime).
PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: the Plausible API host.
# Defaults to the self-hosted MultaEnhavo instance
# (https://analytics.multaenhavo.com) — only set this to override it.
PUBLIC_PLAUSIBLE_API_HOST=

# Backend API that feeds the map/dashboard (data is collected elsewhere
# and served through this endpoint). Consumed by the display frontend.
PUBLIC_API_BASE_URL=
