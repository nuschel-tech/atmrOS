# atmrOS — Umgebungsvariablen. Kopieren nach .env und anpassen.

# --- Datenbank ---------------------------------------------------------------
POSTGRES_USER=atmros
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atmros

# --- Ports (Host) ------------------------------------------------------------
API_PORT=8000
WEB_PORT=4321

# --- Frontend + Single-Origin (alles unter atomar.org) -----------------------
# Deployment-Modell: web auf https://atomar.org, api auf https://atomar.org/api
# (kein Subdomain). Same-Origin => das Cookie fliegt automatisch mit, kein CORS,
# keine Cookie-Domain nötig. PUBLIC_*-Werte werden beim `build` ins Bundle gebacken.

# Öffentliche URL der API, wie der Browser sie erreicht (Single-Origin: /api).
PUBLIC_API_BASE=https://atomar.org/api
# Basemap-Style-JSON (selbst gehostet im Repo, dunkel/minimal).
PUBLIC_BASEMAP_STYLE=/basemap/style.json
# Selbst gehostete Protomaps-Basemap (.pmtiles) + Glyphs auf dem MultaEnhavo-CDN.
PUBLIC_PMTILES_URL=https://static.multaenhavo.com/atmros/basemap/bayern-basemap.pmtiles
PUBLIC_GLYPHS_URL=https://static.multaenhavo.com/atmros/fonts/{fontstack}/{range}.pbf

# --- API-Routing -------------------------------------------------------------
# Pfad-Präfix der API. Single-Origin: /api (Proxy leitet atomar.org/api durch,
# ohne den Pfad zu strippen). Leer => Routen liegen auf Root (nur-lokal/Subdomain).
ATMROS_API_ROOT_PATH=/api
# CORS greift nur bei Cross-Origin; bei Single-Origin ungenutzt, aber gesetzt.
ATMROS_CORS_ORIGINS=https://atomar.org

# --- Login-Gate (Coming-soon bis Launch) -------------------------------------
# false => Coming-soon-Seite; Zugang nur über /unlock mit Passwort.
# Launch-Tag: auf true setzen + Container (web, api) neu starten. Sonst nichts.
ATMROS_LAUNCHED=false
# bcrypt-Hash des Entsperr-Passworts (NICHT das Klartext-Passwort!). Erzeugen:
#   docker run --rm httpd:2.4 htpasswd -nbBC 12 x 'DEIN-PASSWORT' | cut -d: -f2
#   oder: node -e "console.log(require('bcryptjs').hashSync('DEIN-PASSWORT',12))"
ATMROS_UNLOCK_PASSWORD_HASH=
# Zufälliger Secret zum Signieren des Session-Cookies (gleich für web UND api!).
#   openssl rand -hex 32
ATMROS_SESSION_SECRET=
# Cookie-Domain: bei Single-Origin (alles auf atomar.org) LEER lassen. Nur nötig,
# wenn web und api auf verschiedenen Sub-Domains derselben Site liegen (.atomar.org).
ATMROS_COOKIE_DOMAIN=

# --- Ingest ------------------------------------------------------------------
ATMROS_PBF_URL=https://download.geofabrik.de/europe/germany/bayern-latest.osm.pbf

# Node-Location-Index für Way-Geometrie. Default: sparse_file_array (Index auf
# der Platte, RAM bleibt klein) — sicher auf einem 4-GB-Host (CX22), auch wenn
# Postgres parallel arbeitet. Alternative 'flex_mem' ist schneller, braucht aber
# ~2,1 GB Peak-RAM für Bayern (gemessen) und lässt auf 4 GB kaum Luft.
ATMROS_OSM_INDEX=sparse_file_array,/data/node.idx
