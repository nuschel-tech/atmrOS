# atmrOS — Umgebungsvariablen. Kopieren nach .env und anpassen.

# --- Datenbank ---------------------------------------------------------------
POSTGRES_USER=atmros
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atmros

# --- Ports (Host) ------------------------------------------------------------
API_PORT=8000
WEB_PORT=4321

# --- Frontend (zur BUILD-Zeit in die statische Site gebacken) ----------------
# Öffentliche URL der atmrOS-API, wie sie der Browser erreicht.
PUBLIC_API_BASE=http://localhost:8000
# Basemap-Style. Platzhalter CARTO dark-matter; zum Selbst-Hosten auf eigene
# style.json (z.B. BunnyCDN) umstellen.
PUBLIC_BASEMAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# --- API CORS ----------------------------------------------------------------
ATMROS_CORS_ORIGINS=*

# --- Ingest ------------------------------------------------------------------
ATMROS_PBF_URL=https://download.geofabrik.de/europe/germany/bayern-latest.osm.pbf
