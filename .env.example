# atmrOS — Umgebungsvariablen. Kopieren nach .env und anpassen.

# --- Datenbank ---------------------------------------------------------------
POSTGRES_USER=atmros
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atmros

# --- Ports (Host) ------------------------------------------------------------
API_PORT=8000
WEB_PORT=4321

# --- Frontend (zur BUILD-Zeit in die statische Site gebacken) ----------------
# Öffentliche URL der atmrOS-API, wie sie der Browser erreicht.
PUBLIC_API_BASE=http://localhost:8000
# Basemap-Style. Platzhalter CARTO dark-matter; zum Selbst-Hosten auf eigene
# style.json (z.B. BunnyCDN) umstellen.
PUBLIC_BASEMAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# --- API CORS ----------------------------------------------------------------
# Mit Cookie-Gate: explizite Web-Origin (kein "*" mit Credentials). Komma-Liste.
# Prod-Beispiel: https://atomar.org
ATMROS_CORS_ORIGINS=http://localhost:4321

# --- Login-Gate (Coming-soon bis Launch) -------------------------------------
# false => Coming-soon-Seite; Zugang nur über /unlock mit Passwort.
# Launch-Tag: auf true setzen + Container (web, api) neu starten. Sonst nichts.
ATMROS_LAUNCHED=false
# bcrypt-Hash des Entsperr-Passworts (NICHT das Klartext-Passwort!). Erzeugen:
#   docker run --rm httpd:2.4 htpasswd -nbBC 12 x 'DEIN-PASSWORT' | cut -d: -f2
#   oder: node -e "console.log(require('bcryptjs').hashSync('DEIN-PASSWORT',12))"
ATMROS_UNLOCK_PASSWORD_HASH=
# Zufälliger Secret zum Signieren des Session-Cookies (gleich für web UND api!).
#   openssl rand -hex 32
ATMROS_SESSION_SECRET=
# Optional: Cookie-Domain, wenn web und api auf verschiedenen Sub-Domains
# derselben Site laufen (z.B. .atomar.org). Leer lassen bei gleicher Origin.
ATMROS_COOKIE_DOMAIN=

# --- Ingest ------------------------------------------------------------------
ATMROS_PBF_URL=https://download.geofabrik.de/europe/germany/bayern-latest.osm.pbf

# Node-Location-Index für Way-Geometrie. Default: sparse_file_array (Index auf
# der Platte, RAM bleibt klein) — sicher auf einem 4-GB-Host (CX22), auch wenn
# Postgres parallel arbeitet. Alternative 'flex_mem' ist schneller, braucht aber
# ~2,1 GB Peak-RAM für Bayern (gemessen) und lässt auf 4 GB kaum Luft.
ATMROS_OSM_INDEX=sparse_file_array,/data/node.idx
