---
// Entsperren — Material 3 Expressive, aber SELBST-ENTHALTEN: im gesperrten
// Zustand blockiert die Middleware /_astro-Bundles, daher keine @material/web-
// Komponenten hier; die M3-Optik (Filled Text Field, Filled Button, Tonal-Card)
// ist mit den Token-Werten aus der Dynamic-Color-Engine handgebaut. Fonts über
// das freigegebene /fonts. GET zeigt das Formular, POST prüft das Passwort
// gegen den bcrypt-Hash und setzt das signierte Cookie.
import { verifyPassword } from "../lib/auth";
import { signSession, verifySession } from "../lib/session";
import { rateLimit, clientIp } from "../lib/ratelimit";
import { M3_DARK as T } from "../lib/m3-color.generated";
import { PETAL_PATH } from "../lib/m3e";

const COOKIE = "atmros_session";
const TTL_DAYS = 30;

// Nach dem Launch ist das Gate aus — /unlock leitet zur App.
if (process.env.ATMROS_LAUNCHED === "true") {
  return Astro.redirect("/");
}
// Wer schon entsperrt ist, muss nicht erneut.
const existing = Astro.cookies.get(COOKIE)?.value;
if (existing && verifySession(process.env.ATMROS_SESSION_SECRET ?? "", existing)) {
  return Astro.redirect("/");
}

let error = "";

if (Astro.request.method === "POST") {
  const rl = rateLimit(clientIp(Astro.request));
  if (!rl.ok) {
    error = `Zu viele Versuche. Erneut in ${rl.retryMinutes} Min.`;
  } else {
    const form = await Astro.request.formData();
    const password = String(form.get("pw") ?? "");
    const hash = process.env.ATMROS_UNLOCK_PASSWORD_HASH ?? "";
    const secret = process.env.ATMROS_SESSION_SECRET ?? "";
    if (hash && secret && (await verifyPassword(password, hash))) {
      Astro.cookies.set(COOKIE, signSession(secret, TTL_DAYS), {
        httpOnly: true,
        secure: true,
        sameSite: "lax",
        path: "/",
        maxAge: TTL_DAYS * 86400,
        ...(process.env.ATMROS_COOKIE_DOMAIN ? { domain: process.env.ATMROS_COOKIE_DOMAIN } : {}),
      });
      return Astro.redirect("/");
    }
    error = "Zugriff verweigert.";
  }
}

const css = `
  @font-face{font-family:"Roboto";src:url("/fonts/roboto-latin-400-normal.woff2") format("woff2");font-weight:400;font-display:swap}
  @font-face{font-family:"Roboto";src:url("/fonts/roboto-latin-500-normal.woff2") format("woff2");font-weight:500;font-display:swap}
  @font-face{font-family:"Roboto";src:url("/fonts/roboto-latin-700-normal.woff2") format("woff2");font-weight:700;font-display:swap}
  :root{
    --primary:${T.primary};--on-primary:${T.onPrimary};
    --primary-container:${T.primaryContainer};--on-primary-container:${T.onPrimaryContainer};
    --surface:${T.surface};--sc-low:${T.surfaceContainerLow};--sc:${T.surfaceContainer};
    --sc-high:${T.surfaceContainerHigh};--sc-highest:${T.surfaceContainerHighest};
    --on-surface:${T.onSurface};--on-surface-variant:${T.onSurfaceVariant};
    --outline:${T.outline};--outline-variant:${T.outlineVariant};
    --error-container:${T.errorContainer};--on-error-container:${T.onErrorContainer};
    --spring:cubic-bezier(0.34,1.56,0.64,1);
    --font:"Roboto","Segoe UI",system-ui,-apple-system,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{margin:0;min-height:100%}
  body{
    background:
      radial-gradient(900px 600px at 85% -10%, color-mix(in srgb, var(--primary-container) 24%, transparent) 0%, transparent 62%),
      var(--surface);
    color:var(--on-surface);font-family:var(--font);
    display:flex;align-items:center;justify-content:center;min-height:100vh;
  }
  .petal{position:fixed;width:min(38vmin,340px);height:min(38vmin,340px);
    top:-8%;right:-6%;color:var(--primary-container);opacity:.4;
    animation:spin 80s linear infinite;pointer-events:none}
  .petal svg{width:100%;height:100%;display:block}
  @keyframes spin{to{transform:rotate(360deg)}}
  .card{
    position:relative;z-index:1;width:min(420px,92vw);
    background:var(--sc-low);border-radius:28px;padding:30px 28px 26px;
    animation:pop .7s var(--spring) both;
  }
  @keyframes pop{from{opacity:0;transform:translateY(26px) scale(.95)}to{opacity:1;transform:none}}
  h1{margin:0 0 4px;font-size:30px;font-weight:800;letter-spacing:-.02em}
  h1 .os{color:var(--primary)}
  .sub{margin:0 0 24px;font-size:14px;color:var(--on-surface-variant)}
  /* M3 Filled Text Field (handgebaut) */
  .field{
    background:var(--sc-highest);border-radius:8px 8px 0 0;
    border-bottom:1px solid var(--on-surface-variant);
    padding:9px 16px 8px;transition:border-color .15s;
  }
  .field:focus-within{border-bottom:2px solid var(--primary);padding-bottom:7px}
  .field label{display:block;font-size:11.5px;font-weight:500;color:var(--on-surface-variant)}
  .field:focus-within label{color:var(--primary)}
  .field input{
    width:100%;background:transparent;border:0;outline:none;
    color:var(--on-surface);font-family:var(--font);font-size:16px;padding:3px 0 1px;
  }
  form{display:flex;flex-direction:column;gap:18px}
  button{
    align-self:flex-end;
    background:var(--primary);color:var(--on-primary);border:0;
    border-radius:999px;padding:11px 26px;cursor:pointer;
    font-family:var(--font);font-size:14px;font-weight:600;
    transition:box-shadow .15s, filter .15s;
  }
  button:hover{filter:brightness(1.06);box-shadow:0 2px 10px color-mix(in srgb, var(--primary) 35%, transparent)}
  .err{
    display:flex;align-items:center;gap:8px;margin:16px 0 0;
    background:var(--error-container);color:var(--on-error-container);
    border-radius:12px;padding:10px 14px;font-size:13.5px;
    animation:pop .5s var(--spring) both;
  }
  .hint{margin:18px 0 0;font-size:12px;color:var(--outline)}
  @media(prefers-reduced-motion:reduce){.petal,.card,.err{animation:none}}
`;
---
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>atmrOS · Zugang</title>
<style is:inline set:html={css}></style>
</head>
<body>
  <div class="petal" aria-hidden="true">
    <svg viewBox="0 0 200 200"><path fill="currentColor" d={PETAL_PATH} /></svg>
  </div>
  <main class="card">
    <h1>atmr<span class="os">OS</span></h1>
    <p class="sub">Zugang anfordern — Passwort erforderlich.</p>
    <form method="POST" autocomplete="off">
      <div class="field">
        <label for="pw">Passwort</label>
        <input id="pw" type="password" name="pw" autofocus />
      </div>
      <button type="submit">Entsperren</button>
    </form>
    {error && <p class="err">{error}</p>}
    <p class="hint">Sitzung 30 Tage gültig.</p>
  </main>
</body>
</html>
