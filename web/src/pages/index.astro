---
import "../styles/m3.css";
import "../styles/expressive.css";
import "../styles/theme.css";
import pkg from "../../package.json";

const VERSION = pkg.version;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark light" />
    <title>atmrOS — Infrastruktur Bayern</title>
  </head>
  <body>
    <!-- atmrOS — das ehrliche ctOS. Dunkle Karte Bayerns, eine Infrastruktur-
         Ebene, Klick öffnet den Profiler mit Quelle + Stand-Datum. -->
    <div id="map"></div>

    <header class="hud-top">
      <div class="brand">atmr<span class="os">OS</span></div>
    </header>

    <div class="hud-actions">
      <button id="changes-toggle" class="hud-btn" aria-pressed="false">
        Änderungen<span id="changes-count" class="hud-badge" hidden></span>
      </button>
    </div>

    <section id="changes" class="changes-drawer" hidden aria-label="Änderungen">
      <div class="changes-head">
        <span>Änderungen <span class="changes-since">· letzte 7 Tage</span></span>
        <md-icon-button id="changes-close" aria-label="Schließen">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"/></svg>
        </md-icon-button>
      </div>
      <div id="changes-list" class="changes-list"></div>
    </section>

    <aside class="legend">
      <h4>Ebene · Filter</h4>
      <div id="legend-body"><div class="lg-hint">// lade Zähler …</div></div>
    </aside>

    <section id="panel" class="panel" aria-live="polite">
      <div class="panel-head">
        <div id="panel-head-content" class="title"></div>
        <md-icon-button id="panel-close" aria-label="Schließen">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"/></svg>
        </md-icon-button>
      </div>
      <div id="panel-body" class="panel-body"></div>
    </section>

    <div id="updating" class="updating" role="status" hidden>
      <span class="updating-dot"></span>
      <span>// Daten werden aktualisiert …</span>
    </div>

    <div id="toast" class="toast" role="status" hidden>
      <span class="toast-msg">// neuer Stand verfügbar</span>
      <md-filled-button id="toast-apply">aktualisieren</md-filled-button>
    </div>

    <!-- Zoom + Info als gemeinsame M3-Control-Säule (ersetzt MapLibre-Defaults) -->
    <div class="map-controls">
      <md-icon-button id="zoom-in" aria-label="Hineinzoomen">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z"/></svg>
      </md-icon-button>
      <md-icon-button id="zoom-out" aria-label="Herauszoomen">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M5 11h14v2H5z"/></svg>
      </md-icon-button>
      <md-icon-button id="info-open" aria-label="Info und Lizenzen">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M11 7h2v2h-2zm0 4h2v6h-2zm1-9a10 10 0 1 0 0 20 10 10 0 0 0 0-20m0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16"/></svg>
      </md-icon-button>
    </div>
    <span class="map-attrib">© OpenStreetMap-Mitwirkende</span>

    <!-- Zentraler Info-Dialog: Version, Datenstand, Quellen, Lizenzen, Rechtliches -->
    <md-dialog id="info-dialog">
      <div slot="headline">atmr<span class="dlg-os">OS</span></div>
      <div slot="content" class="info-content">
        <p class="info-tagline">
          Die Infrastruktur Bayerns als eine Ebene — mit Gedächtnis, und jede
          Anzeige trägt ihre Quelle.
        </p>
        <div class="info-grid">
          <span class="k">Version</span><span>v{VERSION}</span>
          <span class="k">Datenstand</span><span id="info-stand">–</span>
          <span class="k">Betreiber</span><span><a href="https://www.multaenhavo.com" target="_blank" rel="noopener">MultaEnhavo</a></span>
        </div>
        <h5>Datenquellen</h5>
        <p>
          Geodaten © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap-Mitwirkende</a>
          (ODbL), bezogen über <a href="https://download.geofabrik.de/" target="_blank" rel="noopener">Geofabrik</a>.
          Basemap: <a href="https://protomaps.com/" target="_blank" rel="noopener">Protomaps</a>, selbst gehostet.
        </p>
        <h5>Software</h5>
        <p>
          <a href="https://maplibre.org/" target="_blank" rel="noopener">MapLibre GL JS</a> (BSD-3-Clause) ·
          <a href="https://github.com/material-components/material-web" target="_blank" rel="noopener">Material 3 / @material/web</a> (Apache-2.0) ·
          Roboto (Apache-2.0) · PMTiles (BSD-3-Clause) ·
          <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a> (MIT) ·
          <a href="https://fastapi.tiangolo.com/" target="_blank" rel="noopener">FastAPI</a> (MIT) · PostGIS
        </p>
        <h5>Rechtliches</h5>
        <p>
          <a href="https://www.multaenhavo.com/impressum" target="_blank" rel="noopener">Impressum</a> ·
          <a href="https://www.multaenhavo.com/datenschutz" target="_blank" rel="noopener">Datenschutz</a>
        </p>
      </div>
      <div slot="actions">
        <md-text-button id="info-close">Schließen</md-text-button>
      </div>
    </md-dialog>

    <script>
      import "../lib/md";
      import { initMap } from "../lib/map";
      initMap().catch((e) => console.error("atmrOS map init failed", e));
    </script>
  </body>
</html>
