---
import "../styles/m3.css";
import "../styles/expressive.css";
import "../styles/theme.css";
import pkg from "../../package.json";
import { wavySvg } from "../lib/m3e";

const VERSION = pkg.version;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark light" />
    <title>atmrOS — Infrastruktur Bayern</title>
  </head>
  <body>
    <!-- Boot-Overlay: sofort im ersten Paint da. map.ts füllt den Quellen-
         Status, sobald /stats da ist ("System online"), blendet aus und fliegt
         in die Karte (hartes Timeout — blockiert nie). -->
    <div id="boot" class="boot" aria-hidden="true">
      <div class="boot-brand">atmr<span class="os">OS</span></div>
      <div class="boot-statement">Die Infrastruktur Bayerns.<br />Eine Ebene. Mit Gedächtnis.</div>
      <div class="m3e-progress boot-wave" set:html={wavySvg()} />
      <div id="boot-status" class="boot-status" hidden></div>
    </div>

    <!-- atmrOS — das ehrliche ctOS. Dunkle Karte Bayerns, eine Infrastruktur-
         Ebene, Klick öffnet den Profiler mit Quelle + Stand-Datum. -->
    <div id="map"></div>

    <header class="hud-top">
      <div class="brand">atmr<span class="os">OS</span></div>
    </header>

    <!-- Dock: die Taskbar des OS. Die Karte ist der Desktop, Module (Änderungen,
         System, Info) sind Overlays darüber — nie ein Seitenwechsel. -->
    <nav class="dock" aria-label="Module">
      <button id="dock-map" class="dock-btn" aria-pressed="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="m15 21-6-2.1-4.65 1.8A1 1 0 0 1 3 19.77V5.83a1 1 0 0 1 .67-.94L9 3l6 2.1 4.65-1.8A1 1 0 0 1 21 4.23v13.94a1 1 0 0 1-.67.94zM14 18.55V6.86l-4-1.4v11.69z"/></svg>
        <span class="lbl">Karte</span>
      </button>
      <button id="changes-toggle" class="dock-btn" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M13 3a9 9 0 1 0 8.95 10h-2.02A7 7 0 1 1 13 5c1.93 0 3.68.79 4.95 2.05L15 10h7V3l-2.64 2.64A8.96 8.96 0 0 0 13 3m-1 5v5l4.25 2.52.77-1.28-3.52-2.09V8z"/></svg>
        <span class="lbl">Änderungen</span>
        <span id="changes-count" class="hud-badge dock-badge" hidden></span>
      </button>
      <button id="dock-system" class="dock-btn" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M9 3h2v3h2V3h2v3h2a1 1 0 0 1 1 1v2h3v2h-3v2h3v2h-3v2a1 1 0 0 1-1 1h-2v3h-2v-3h-2v3H9v-3H7a1 1 0 0 1-1-1v-2H3v-2h3v-2H3V9h3V7a1 1 0 0 1 1-1h2zM8 8v8h8V8zm2 2h4v4h-4z"/></svg>
        <span class="lbl">System</span>
      </button>
      <button id="dock-info" class="dock-btn" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M11 7h2v2h-2zm0 4h2v6h-2zm1-9a10 10 0 1 0 0 20 10 10 0 0 0 0-20m0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16"/></svg>
        <span class="lbl">Info</span>
      </button>
    </nav>

    <section id="changes" class="changes-drawer" hidden aria-label="Änderungen">
      <div class="changes-head">
        <span>Änderungen <span class="changes-since">· letzte 7 Tage</span></span>
        <md-icon-button id="changes-close" aria-label="Schließen">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"/></svg>
        </md-icon-button>
      </div>
      <div id="changes-list" class="changes-list"></div>
    </section>

    <aside class="legend">
      <!-- Ansicht 0: Quellen — die Kern-Signatur als Einstieg. Klick auf die
           Quelle zeigt, was sie liefert (Kategorien -> Untertypen). -->
      <div id="legend-sources" class="src-list"><div class="lg-hint">// lade Quellen …</div></div>
      <!-- Ansicht 1: Kategorien EINER Quelle (2-Spalten-Grid, gleich breit) -->
      <div id="legend-cats" class="cat-view" hidden>
        <div class="detail-head">
          <md-icon-button id="cats-back" aria-label="Zurück zu den Quellen">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="m10.9 19.1-6.4-6.4a1 1 0 0 1 0-1.4l6.4-6.4 1.4 1.4L7.7 11H20v2H7.7l4.6 4.7z"/></svg>
          </md-icon-button>
          <span id="cats-title" class="detail-title"></span>
          <md-text-button id="cats-all" class="detail-all">zurücksetzen</md-text-button>
        </div>
        <div id="legend-grid" class="cat-grid"></div>
      </div>
      <!-- Ansicht 2: Untertypen-Drilldown (in derselben Card, mit Zurück) -->
      <div id="legend-detail" class="cat-detail" hidden>
        <div class="detail-head">
          <md-icon-button id="detail-back" aria-label="Zurück zu den Kategorien">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="m10.9 19.1-6.4-6.4a1 1 0 0 1 0-1.4l6.4-6.4 1.4 1.4L7.7 11H20v2H7.7l4.6 4.7z"/></svg>
          </md-icon-button>
          <span id="detail-dot" class="dot"></span>
          <span id="detail-title" class="detail-title"></span>
          <md-text-button id="detail-all" class="detail-all">zurücksetzen</md-text-button>
        </div>
        <div id="subs-list" class="subs-list"></div>
      </div>
    </aside>

    <section id="panel" class="panel" aria-live="polite">
      <div class="panel-head">
        <div id="panel-head-content" class="title"></div>
        <md-icon-button id="panel-close" aria-label="Schließen">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"/></svg>
        </md-icon-button>
      </div>
      <div id="panel-body" class="panel-body"></div>
    </section>

    <div id="updating" class="updating" role="status" hidden>
      <span class="updating-dot"></span>
      <span>// Daten werden aktualisiert …</span>
    </div>

    <div id="toast" class="toast" role="status" hidden>
      <span class="toast-msg">// neuer Stand verfügbar</span>
      <md-filled-button id="toast-apply">aktualisieren</md-filled-button>
    </div>

    <!-- Zoom als M3-Control-Säule (Info wohnt jetzt im Dock) -->
    <div class="map-controls">
      <md-icon-button id="zoom-in" aria-label="Hineinzoomen">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z"/></svg>
      </md-icon-button>
      <md-icon-button id="zoom-out" aria-label="Herauszoomen">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M5 11h14v2H5z"/></svg>
      </md-icon-button>
    </div>
    <span class="map-attrib">© OpenStreetMap-Mitwirkende</span>

    <!-- System-Modul: die Kette sichtbar gemacht — Quellen, Stände, Ereignisse -->
    <section id="system" class="panel system" aria-label="System">
      <div class="panel-head">
        <div class="title">
          <div class="cat">System</div>
          <div class="id">atmrOS v{VERSION}</div>
        </div>
        <md-icon-button id="system-close" aria-label="Schließen">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"/></svg>
        </md-icon-button>
      </div>
      <div id="system-body" class="panel-body"></div>
    </section>

    <!-- Zentraler Info-Dialog: Version, Datenstand, Quellen, Lizenzen, Rechtliches -->
    <md-dialog id="info-dialog">
      <div slot="headline">atmr<span class="dlg-os">OS</span></div>
      <div slot="content" class="info-content">
        <p class="info-tagline">
          Die Infrastruktur Bayerns als eine Ebene — mit Gedächtnis, und jede
          Anzeige trägt ihre Quelle.
        </p>
        <div class="info-grid">
          <span class="k">Version</span><span>v{VERSION}</span>
          <span class="k">Datenstand</span><span id="info-stand">–</span>
          <span class="k">Betreiber</span><span><a href="https://www.multaenhavo.com" target="_blank" rel="noopener">MultaEnhavo</a></span>
        </div>
        <h5>Datenquellen</h5>
        <p>
          Geodaten © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap-Mitwirkende</a>
          (ODbL), bezogen über <a href="https://download.geofabrik.de/" target="_blank" rel="noopener">Geofabrik</a>.
          Pegel: <a href="https://www.pegelonline.wsv.de/" target="_blank" rel="noopener">PEGELONLINE</a> /
          Wasserstraßen- und Schifffahrtsverwaltung des Bundes (dl-zero-de/2.0).
          Basemap: <a href="https://protomaps.com/" target="_blank" rel="noopener">Protomaps</a>, selbst gehostet.
        </p>
        <h5>Software</h5>
        <p>
          <a href="https://maplibre.org/" target="_blank" rel="noopener">MapLibre GL JS</a> (BSD-3-Clause) ·
          <a href="https://github.com/material-components/material-web" target="_blank" rel="noopener">Material 3 / @material/web</a> (Apache-2.0) ·
          Roboto (Apache-2.0) · PMTiles (BSD-3-Clause) ·
          <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a> (MIT) ·
          <a href="https://fastapi.tiangolo.com/" target="_blank" rel="noopener">FastAPI</a> (MIT) · PostGIS
        </p>
        <h5>Rechtliches</h5>
        <p>
          <a href="https://www.multaenhavo.com/impressum" target="_blank" rel="noopener">Impressum</a> ·
          <a href="https://www.multaenhavo.com/datenschutz" target="_blank" rel="noopener">Datenschutz</a>
        </p>
      </div>
      <div slot="actions">
        <md-text-button id="info-close">Schließen</md-text-button>
      </div>
    </md-dialog>

    <script>
      import "../lib/md";
      import { initMap } from "../lib/map";
      initMap().catch((e) => console.error("atmrOS map init failed", e));
    </script>
  </body>
</html>
